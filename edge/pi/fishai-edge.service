[Unit]
Description=FishAI edge agent (camera, sensors, feeder)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/fishai-edge
# Edit the pins and camera settings for your rail. See README.md.
ExecStart=/usr/bin/python3 /opt/fishai-edge/fishai_edge.py --port 8000 --fps 10 --exposure-us 8000 --gain 2.0 --float-pin 17 --feeder-pin 27 --home-pin 22 --button-pin 23
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
