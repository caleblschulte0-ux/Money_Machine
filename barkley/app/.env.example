# Barkley app environment. Copy to .env for local development.
#
# EXPO_PUBLIC_* values are BUNDLED INTO THE APP BINARY. They are not secrets.
# Putting a real API key here is a development convenience only — production
# traffic must go through a backend proxy that holds the real key
# (set EXPO_PUBLIC_BARKLEY_BACKEND_URL and leave the key empty).

# Dev-only: direct Anthropic access from the device. NEVER ship a build with this set.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Production path: base URL of the Barkley backend proxy (not built yet — next sprint).
EXPO_PUBLIC_BARKLEY_BACKEND_URL=

# Optional dialogue model override (default: claude-opus-5).
EXPO_PUBLIC_BARKLEY_MODEL=

# With everything above empty the app still runs, using the offline scripted
# dialogue provider — useful for UI work and demos with zero credentials.
