# ---------------------------------------------------------------------------
# AI Holding Company — example environment.
# Copy to .env and edit. NEVER commit a real .env.
# Every value below is either a safe default or an obvious placeholder.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Persistence -----------------------------------------------------------
# STORE_DRIVER=memory  -> zero-config, in-process store. Default. Data is lost
#                         on restart. Used by tests and `pnpm dev`.
# STORE_DRIVER=prisma  -> requires DATABASE_URL and `pnpm db:push`.
STORE_DRIVER=memory
DATABASE_URL=postgresql://holdco:holdco@localhost:5432/holdco?schema=public

# Load fictional demo companies into the Command Center. OFF by default: an
# empty dashboard is the honest default, because nothing is operating yet.
# Turning this on fills the screen with invented revenue and customers.
DEMO_DATA=false

# --- Queue -----------------------------------------------------------------
# QUEUE_DRIVER=memory | redis
QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# --- Provider selection ----------------------------------------------------
# All providers default to mock. Mocks never touch the network and never spend
# money. Switching any of these to a live value ALSO requires
# ALLOW_PAID_PROVIDERS=true, which is an owner decision, not an agent decision.
MODEL_PROVIDER=mock
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
TELEPHONY_PROVIDER=mock
PAYMENT_PROVIDER=mock
STORAGE_PROVIDER=memory

# Master safety switches. Leave false unless a human has explicitly approved
# spend and live traffic for this environment.
ALLOW_PAID_PROVIDERS=false
ALLOW_LIVE_COMMUNICATIONS=false

# --- Vendor credentials (placeholders only) --------------------------------
# Fill these in your local .env only when the corresponding provider above is
# switched off "mock" AND spend has been approved.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Security --------------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-me-with-32-bytes-of-base64-randomness
FIELD_ENCRYPTION_KEY=replace-me-with-32-bytes-of-base64-randomness

# --- Budgets (USD, monthly, holding-company wide) --------------------------
# Enforced by @holdco/cost-accounting. Workflows and agents refuse to run once
# a budget is exhausted rather than silently overspending.
BUDGET_AI_INFERENCE_MONTHLY=200
BUDGET_ADVERTISING_MONTHLY=0
BUDGET_CONTRACTOR_MONTHLY=0
BUDGET_EXPERIMENT_MONTHLY=500

# --- Approvals -------------------------------------------------------------
# Any single action with financial impact at or above this threshold requires
# a human approval regardless of the workflow's autonomy level.
APPROVAL_THRESHOLD_USD=100
