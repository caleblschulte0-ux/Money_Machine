{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "STORE_DRIVER",
    "MODEL_PROVIDER",
    "EMAIL_PROVIDER",
    "SMS_PROVIDER",
    "TELEPHONY_PROVIDER",
    "PAYMENT_PROVIDER",
    "ALLOW_PAID_PROVIDERS",
    "ALLOW_LIVE_COMMUNICATIONS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    }
  }
}
