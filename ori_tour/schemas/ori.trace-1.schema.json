{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrangeinteractive.example/schemas/ori.trace-1.schema.json",
  "title": "ORI recorded walk, version 1",
  "description": "A walk as raw sensor readings, for replaying through the tour engine. Recorded on a phone with ?record=1, or generated (source: synthetic). t is milliseconds from the start of the walk.",
  "type": "object",
  "required": ["schema", "source", "samples"],
  "properties": {
    "schema": { "const": "ori.trace/1" },
    "tour": { "type": "string" },
    "source": { "enum": ["recorded", "synthetic", "gpx"] },
    "device": { "type": "string" },
    "recorded": { "type": "string" },
    "note": { "type": "string" },
    "headingless": { "type": "boolean" },
    "samples": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["t", "lat", "lon"],
            "properties": {
              "t": { "type": "number", "minimum": 0 },
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lon": { "type": "number", "minimum": -180, "maximum": 180 },
              "acc": { "type": "number", "minimum": 0 },
              "speed": { "type": ["number", "null"] }
            }
          },
          {
            "type": "object",
            "required": ["t", "heading"],
            "properties": { "t": { "type": "number" }, "heading": { "type": "number" } }
          },
          {
            "type": "object",
            "required": ["t", "a"],
            "properties": { "t": { "type": "number" }, "a": { "type": "number" } }
          }
        ]
      }
    }
  }
}
