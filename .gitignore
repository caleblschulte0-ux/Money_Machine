__pycache__/

# Render output -- never commit media (storage rule: mp4/png renders and
# anything >256KB stay out of git; MP4s go to the operator directly via
# SendUserFile, contact sheets go to the operator or the ORI_AI_HANDOFF
# Drive mailbox, never into the repo itself).
ori_promo/*/out/
ori_promo/out/
ori_promo/*/out_*/
ori_promo/*/concat_*.txt
# The working-directory copy contact_layer.py-style scripts write before
# this session copies the real one into handoff_media/ (the actual
# tracked location) -- a stray duplicate left behind twice now (r226,
# r234) rather than a one-off.
ori_promo/*/r*__*__contact.*

# Locally-provisioned inputs -- large, regenerable, never committed
# (storage rule: nothing >256KB in git). Raw footage is downloaded per
# ori_promo/manifest.txt (Drive file IDs, all link-shared); fonts are
# the open-source Inter family; the Piper voice model is fetched from
# rhasspy/piper-voices on HuggingFace. All three are re-provisioned
# fresh at the start of a session, not carried in the repo.
ori_promo/raw/
ori_promo/fonts/
ori_promo/vo/voices/

# ori_promo/promo (the 2026-09-21 rebuild): the extra raw clips pulled from
# the same manifest, the CC-BY music candidates (incompetech, regenerable
# with the URLs in promo/spec.py), and the build's intermediates are all
# large and regenerable -- only spec.py/build.py are tracked.
ori_promo/raw_more/
ori_promo/music/
ori_promo/promo/work/
