# Barkly app environment. Copy to .env for local development.
#
# EXPO_PUBLIC_* values are BUNDLED INTO THE APP BINARY. They are not secrets.
# Anyone who unpacks a build can read every one of them. A real API key here is
# a development convenience only — production traffic goes through the backend
# proxy in ../server, which holds the key and decides model, size, rate and
# budget on its own side.

# ---------------------------------------------------------------- production
# Base URL of the Barkly backend proxy (see ../server/README.md).
EXPO_PUBLIC_BARKLY_BACKEND_URL=

# Sent as x-barkly-app-token. Must match the proxy's BARKLY_APP_TOKEN.
# This is obfuscation, NOT authentication — the app ships it. It stops a
# stranger curling the proxy; the rate limit and budget caps are what actually
# bound the damage.
EXPO_PUBLIC_BARKLY_APP_TOKEN=

# --------------------------------------------------------------- development
# Direct Anthropic access from the device. NEVER ship a build with this set.
# Ignored when EXPO_PUBLIC_BARKLY_BACKEND_URL is present.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Optional dialogue model override (default: claude-opus-5). The proxy has its
# own allowlist, so a model it does not permit is refused there.
EXPO_PUBLIC_BARKLY_MODEL=

# Barkly's own voice comes from the same proxy (ELEVENLABS_API_KEY and
# BARKLY_VOICE_ID live there, never here). Set this to "off" to force the
# device voice for a demo or a test build.
EXPO_PUBLIC_BARKLY_VOICE=

# ---------------------------------------------------------------------- demo
# With everything above empty the app still runs on the offline scripted
# Barkly — useful for UI work and demos with zero credentials. Settings says
# plainly which brain is answering.

# Set to 1 to force typed input instead of the microphone (browser demos,
# sandboxed pages).
EXPO_PUBLIC_BARKLY_FORCE_KEYBOARD=

# Renderer: photo (real concept-sheet renders, default) or vector (hand-drawn).
EXPO_PUBLIC_BARKLY_RENDERER=
