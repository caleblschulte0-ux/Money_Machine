# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# env (never commit real credentials)
.env
.env.*
!.env.example

# Review-harness output. overlap-check, the art lab and the world-art snapshot
# all rewrite these on every run, and they are regenerable from any build in
# one command. Three of them were tracked and the rest were not, so every
# session ended with a dirty tree and ~5MB of binary churn in the diff. They
# are evidence, not source: regenerate them, do not commit them.
overlap-*.png
art-lab/
world-art/
# The playtest build the world-art snapshot serves. `barkly-artifact.html` is
# tracked on purpose -- it is the deliverable -- and this one is not: it is the
# same build with the playtest menu compiled in, rebuilt on every review pass,
# and it went into a commit once as 13MB of noise.
world-artifact.html
# Blender's raw output. CI (and a local `blender -b --python tools/blender/...`)
# writes it, then PROMOTES the trimmed PNGs into assets/world/, which is what
# ships. Keeping both copies doubles ~2MB of binaries in the diff for nothing.
art-review/world-props/
art-review/world-scenes/
art-review/home-props/
art-review/home-architecture/

# Blender driver imports leave these behind when a prop is re-rendered locally.
tools/blender/__pycache__/

# perf-review writes its report here; the numbers belong in a commit message or
# a pull request, not in the tree.
art-review/performance/

# first-ten-minutes writes its transcript here; it is a thing to read, not to keep.
art-review/first-ten-minutes.txt

# Throwaway capture harnesses for looking at a screen during a session.
scripts/zz-*.mjs

# Python bytecode (tools/ and scripts/ are run with python3 directly)
__pycache__/
*.pyc
